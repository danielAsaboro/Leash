  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild",
    "ios": "expo run:ios --device",
    "ipad": "expo run:ios --device",
    "ipad:prebuild": "expo prebuild --platform ios",
    "android": "expo run:android --device",
    "android:release": "expo run:android --device --variant release",
    "bundle:worklets:android": "bare-pack --target android-arm64 --linked --format bundle.cjs --out worklets/mesh-worklet.android.bundle.js worklets/mesh-worklet.mjs && bare-pack --target android-arm64 --linked --format bundle.cjs --out worklets/forward-worklet.android.bundle.js worklets/forward-worklet.mjs && bare-pack --target android-arm64 --linked --format bundle.cjs --out worklets/public-forward-worklet.android.bundle.js worklets/public-forward-worklet.mjs",
    "bundle:worklets:ios": "bare-pack --target ios-arm64 --linked --format bundle.cjs --out worklets/public-forward-worklet.bundle.js worklets/public-forward-worklet.mjs"
  },
  "dependencies": {
    "@hyperswarm/secret-stream": "^6.9.1",
